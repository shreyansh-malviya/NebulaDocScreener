# ---- Copy this file to `.env` and fill in as things become available. ----
# The backend RUNS WITHOUT any of these (safe defaults + in-memory storage).

# Station identity (stamped into every screening + ledger record)
STATION_ID=SSB-DEMO-LANE-1

# ---- Storage ----
# STORAGE_BACKEND: "memory" (default, no setup) or "mongo" (needs MONGO_URI).
STORAGE_BACKEND=memory
# MongoDB — install MongoDB Community Server locally (offline, preferred), OR
# create a free MongoDB Atlas cluster (cloud) and paste its connection string here.
#   Local example:  mongodb://localhost:27017
#   Atlas example:  mongodb+srv://user:pass@cluster0.xxxx.mongodb.net
MONGO_URI=
MONGO_DB=nebula_screening

# ---- Audit ledger ----
# HMAC signing key for the tamper-evident audit ledger. CHANGE THIS for anything real.
# (Production uses ed25519 keys in an HSM/TPM — see 05-INTERNAL-DESIGN.md §6.)
LEDGER_SECRET=dev-insecure-station-key-change-me

# ---- LLM narrative (OPTIONAL — template narrative is the reliable default) ----
# LLM_NARRATIVE: "template" (default, offline, free) | "local" (small local model) | "api"
LLM_NARRATIVE=template
# Only needed if LLM_NARRATIVE=api. Anthropic Claude Haiku recommended (low cost, ~cents/screening).
# Get a key: https://console.anthropic.com/  (or use OpenAI GPT-4o-mini)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Tesseract (OPTIONAL — needed only for MRZ *image* OCR, Module 1 image path) ----
# Install UB Mannheim Tesseract for Windows, then set the full path to tesseract.exe.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
